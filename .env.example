# Site institucional - environment variables
# Copy this file to .env.local and fill in your real values.

# WhatsApp number with country code, digits only.
# Example: 5531999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5531999999999

# Contact email shown as an alternative channel.
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com

# Brand name used in metadata, navigation, and copy.
NEXT_PUBLIC_BRAND_NAME=Keni

# Base site URL used for metadata and absolute links.
# Example: https://meudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
